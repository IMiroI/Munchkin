# JWT Secret — doit faire au moins 32 caractères, garder secret
JWT_SECRET=change_me_to_a_random_32_plus_char_string

# CORS — origines autorisées (séparées par virgule)
CORS_ORIGINS=http://localhost:4200,http://localhost:3002

# Base de données PostgreSQL
POSTGRES_DB=munchkin
POSTGRES_USER=munchkin
POSTGRES_PASSWORD=change_me_strong_password

# Redis (si applicable)
REDIS_URL=redis://redis:6379
