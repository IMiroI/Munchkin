{
  "name": "munchkin",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"pnpm --filter @munchkin/server dev\" \"pnpm --filter @munchkin/client dev\"",
    "build": "pnpm --filter @munchkin/shared build && concurrently \"pnpm --filter @munchkin/server build\" \"pnpm --filter @munchkin/client build\"",
    "test": "pnpm --filter @munchkin/client test",
    "lint": "pnpm --filter @munchkin/server lint && pnpm --filter @munchkin/client lint"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "@angular/common": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/platform-browser": "^21.0.0"
  }
}
