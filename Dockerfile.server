FROM node:22-alpine AS build
WORKDIR /app

RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY server/package.json server/package.json
COPY shared/package.json shared/package.json
COPY client/package.json client/package.json
# `--filter @munchkin/server...` : le suffixe `...` embarque @munchkin/shared, dépendance interne.
# Le client n'est pas installé ici — inutile pour l'image serveur.
RUN pnpm install --frozen-lockfile --filter @munchkin/server...

COPY shared shared
COPY server server
RUN pnpm --filter @munchkin/shared build
RUN pnpm --filter @munchkin/server build
RUN pnpm --filter @munchkin/server db:generate

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app /app

EXPOSE 3001
USER node
WORKDIR /app/server
CMD ["node", "dist/index.js"]
